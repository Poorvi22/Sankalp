
{
  "project": "BizPilot AI",
  "problem": "5A Context-Aware Application Agent",
  "metrics": [
    {
      "name": "intent_to_destination_accuracy",
      "formula": "correct_destinations / total_requests",
      "target": 0.95
    },
    {
      "name": "ui_state_correctness",
      "formula": "fully_correct_ui_states / total_ui_state_tests",
      "target": 0.95
    },
    {
      "name": "multi_step_task_success",
      "formula": "fully_completed_tasks / total_multi_step_tasks",
      "target": 0.90
    },
    {
      "name": "retrieval_precision_at_5",
      "formula": "relevant_items_in_top_5 / 5",
      "target": 0.90
    },
    {
      "name": "retrieval_recall_at_5",
      "formula": "relevant_items_in_top_5 / total_relevant_items",
      "target": 0.85
    },
    {
      "name": "mean_reciprocal_rank",
      "formula": "mean(1 / rank_of_first_relevant_result)",
      "target": 0.90
    },
    {
      "name": "action_hallucination_rate",
      "formula": "unsupported_action_attempts / all_action_attempts",
      "target": 0.0
    },
    {
      "name": "latency_p50_ms",
      "formula": "50th_percentile(end_to_end_latency_ms)",
      "target": null
    },
    {
      "name": "latency_p95_ms",
      "formula": "95th_percentile(end_to_end_latency_ms)",
      "target": null
    },
    {
      "name": "analytical_faithfulness",
      "formula": "supported_analytical_claims / total_analytical_claims",
      "target": 0.95
    }
  ]
}
